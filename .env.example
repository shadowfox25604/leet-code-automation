# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get these from your browser DevTools (Application > Cookies > leetcode.com)
LEETCODE_SESSION=your_leetcode_session_cookie_here
LEETCODE_CSRF_TOKEN=your_csrf_token_here

# Batch & Continuous Solving Settings (optional)
# How many problems to solve in batch mode (default: 5)
BATCH_LIMIT=5
# Delay in seconds between problems to respect API rate limits (default: 3)
DELAY_BETWEEN_PROBLEMS=3

